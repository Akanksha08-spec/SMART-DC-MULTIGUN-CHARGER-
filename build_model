% =====================================================================
% DCDC_g - current loop + CV clamp (G2V) and discharge path (V2G)
% =====================================================================
function s = dcdc_src()
s = sprintf('%s\n',...
'function [ibat,Pdc] = DCDC(Irefg,vbatg,bms,connected,Pavail)',...
'%#codegen',...
'G_INJECT=1; g=G_INJECT; o=(g-1)*7;',...
'Vmax=bms(o+3); Rint=bms(o+6); Imax=bms(o+4);',...
'Ts=0.1; tauI=0.08; persistent I; if isempty(I), I=0; end',...
'Icap=Pavail*1000/max(vbatg,100);',...
'if Irefg >= 0',...
'  Icv=max(I+(Vmax-vbatg)/max(Rint,1e-3),0);',...
'  Icmd=min([Irefg,Icv,Icap]);',...
'else',...
'  Icmd=max([Irefg,-Icap,-Imax]);   % V2G discharge, magnitude-limited',...
'end',...
'Icmd=Icmd*(connected(g)>0.5);',...
'I=I+(Ts/tauI)*(Icmd-I);',...
'ibat=I; Pdc=vbatg*I/1000;',...
'end');
end

% =====================================================================
% Battery_g - SOC integration (both directions), OCV+Rint, thermal state
% =====================================================================
