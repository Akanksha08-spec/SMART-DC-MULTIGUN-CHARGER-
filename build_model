%% ---- routing plumbing -------------------------------------------------
add_block('simulink/Sources/Clock',[mdl '/t'],'Position',[10 220 30 240]);
mux3 = @(nm,pos) add_block('simulink/Signal Routing/Mux',[mdl '/' nm],'Position',pos,'Inputs','3','DisplayOption','bar');
