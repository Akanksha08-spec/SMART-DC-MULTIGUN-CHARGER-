mux3('Ibat_bus',[1230 360 1240 460]); mux3('Tbat_bus',[1230 490 1240 590]);
add_block('simulink/Signal Routing/Demux',[mdl '/Iref_demux'],'Position',[880 270 890 370],'Outputs','3');
