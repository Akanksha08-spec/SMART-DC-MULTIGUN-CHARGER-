addMF('DCDC_1',[930  60 1030 140]); addMF('DCDC_2',[930 180 1030 260]); addMF('DCDC_3',[930 300 1030 380]);
for g=1:3
    src=dcdc_src();
    src=inject(src,'G_INJECT=1;',sprintf('G_INJECT=%d;',g));   % per-gun index
    set_mf_script(mdl,sprintf('DCDC_%d',g),src,P.ts.fast);
end

addMF('Battery_1',[1100  60 1200 140]); addMF('Battery_2',[1100 180 1200 260]); addMF('Battery_3',[1100 300 1200 380]);
for g=1:3
    src=battery_src();
    src=inject(src,'G_INJECT=1;',sprintf('G_INJECT=%d;',g));   % per-gun index
    % scenario initial conditions injected DIRECTLY from ov (not via P/BMS)
    src=inject(src,'SOC0_INJECT=0.15;', sprintf('SOC0_INJECT=%.10g;', ov.soc0(g)));
    src=inject(src,'TBAT0_INJECT=30;',  sprintf('TBAT0_INJECT=%.10g;',ov.temp0(g)));
    src=inject(src,'CTH_INJECT=6e4;',   sprintf('CTH_INJECT=%.10g;', P.th.Cth));
    src=inject(src,'RTH_INJECT=0.01;',  sprintf('RTH_INJECT=%.10g;',P.th.Rth));
    set_mf_script(mdl,sprintf('Battery_%d',g),src,P.ts.fast);
end

addMF('Module_Pool',[930 440 1030 520]);
src=modpool_src();
src=inject(src,'TRD_M=1.0;',  sprintf('TRD_M=%.10g;',  P.sw.tRampDown));
src=inject(src,'TOPEN_M=0.2;',sprintf('TOPEN_M=%.10g;',P.sw.tOpenDelay));
src=inject(src,'TDEAD_M=0.5;',sprintf('TDEAD_M=%.10g;',P.sw.tDeadTime));
src=inject(src,'TCONN_M=0.2;',sprintf('TCONN_M=%.10g;',P.sw.tConnect));
src=inject(src,'TRUP_M=1.0;', sprintf('TRUP_M=%.10g;', P.sw.tRampUp));
% scenario module-fault schedule injected DIRECTLY from ov
src=inject(src,'FAULT_SCHEDULE=zeros(0,4);',sprintf('FAULT_SCHEDULE=%s;',ov.fault));
set_mf_script(mdl,'Module_Pool',src,P.ts.fast);

addMF('AFE_Rectifier',[490 560 590 620]); set_mf_script(mdl,'AFE_Rectifier',afe_src(),P.ts.fast);
addMF('LC_Filter',[630 560 710 620]);     set_mf_script(mdl,'LC_Filter',lcfilter_src(),P.ts.fast);
addMF('DC_Bus',[750 560 850 620]);        set_mf_script(mdl,'DC_Bus',dcbus_src(),P.ts.fast);

% element-wise actual battery power  P = Vbat.*Ibat/1000  (for Scope 2)
add_block('simulink/Math Operations/Product',[mdl '/Pbat_prod'],'Inputs','2','Multiplication','Element-wise(.*)','Position',[1260 520 1290 560]);
add_block('simulink/Math Operations/Gain',[mdl '/Pbat_gain'],'Gain','1/1000','Position',[1310 525 1350 555]);

% ---- port verification -------------------------------------------------
verify_ports(mdl,'ScenarioGen',1,6);
verify_ports(mdl,'VehicleComms',6,6);
verify_ports(mdl,'Constraints',3,2);
verify_ports(mdl,'Supervisor',12,7);
verify_ports(mdl,'RefGen',1,1);
for g=1:3, verify_ports(mdl,sprintf('DCDC_%d',g),5,2); verify_ports(mdl,sprintf('Battery_%d',g),3,3); end
verify_ports(mdl,'Module_Pool',5,9);
verify_ports(mdl,'AFE_Rectifier',2,1);
verify_ports(mdl,'LC_Filter',1,1);
