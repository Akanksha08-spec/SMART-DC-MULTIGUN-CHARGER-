% =====================================================================
% STATION CONSTRAINTS - grid-cap ramp + cabinet thermal hysteresis
% =====================================================================
function s = constraints_src()
s = sprintf('%s\n',...
'function [Pstn,thermDer] = Constraints(gridCap,Ploss,Tamb)',...
'%#codegen',...
'Ptotal=180; Ts=1.0; RAMP=10;',...
'persistent PgridF Tcab derOn;',...
'if isempty(PgridF), PgridF=Ptotal; Tcab=Tamb; derOn=0; end',...
'PgridF=PgridF+max(min(gridCap-PgridF,RAMP*Ts),-RAMP*Ts);',...
'Rth=0.045; Cth=400;',...
'Tcab=Tcab+(Ts/Cth)*(max(Ploss,0)-(Tcab-Tamb)/Rth)*Rth;',...
'if derOn==0 && Tcab>75, derOn=1; end',...
'if derOn==1 && Tcab<65, derOn=0; end',...
'if derOn==1, thermDer=max(0.4,1-0.03*(Tcab-75)); else thermDer=1.0; end',...
'Pstn=min(PgridF,Ptotal)*thermDer;',...
'end');
end

% =====================================================================
% SUPERVISOR - ONE combined hybrid controller (priority + soft EFT) with a
% CONTAINED V2G branch. G2V machinery is the proven code; V2G EVs are sized
% as pseudo-positive demand (so they get modules through the same logic) and
% their Palloc / IrefT are sign-flipped to NEGATIVE at the very end. When
% v2g is all zero this is numerically identical to the proven G2V supervisor.
% =====================================================================
function s = supervisor_src()
s = sprintf('%s\n',...
'function [IrefT,Palloc,Nmod,prio,util,st,ModAssign] = Supervisor(connected,emergency,tdep,evSOC,evImax,evPmax,vbat,Pstn,bms,t,ModStatus,v2g)',...
'%#codegen',...
'MODE_INJECT = 5; mode = MODE_INJECT;',...
'Pmod=30; NmodTot=6; NmodGunMax=4; PgunMax=120; socMin=0.10;',...
'Cap_kWh=[bms(1);bms(8);bms(15)]; PmaxV=[bms(5);bms(12);bms(19)]; ImaxV=[bms(4);bms(11);bms(18)];',...
'soc_stop=0.97; Ts=1.0; tauF=30; DB=0.25; TDWELL=60; TSUST=20; TRD=2; TSW=3; MARGIN=5;',...
'wS=0.35; wD=0.25; wU=0.25; wF=0.15;',...
'persistent prioF modMap pendMap ordP tLast reSt reT taperC Edel swCnt lastC lastP modOwner init;',...
'if isempty(init)',...
'  prioF=zeros(3,1); modMap=zeros(3,1); pendMap=zeros(3,1); ordP=[1;2;3]; tLast=-1e9;',...
'  reSt=0; reT=0; taperC=zeros(3,1); Edel=zeros(3,1); swCnt=0; lastC=zeros(3,1); lastP=180; modOwner=zeros(6,1); init=1;',...
'end',...
'IrefT=zeros(3,1); Palloc=zeros(3,1); prio=zeros(3,1);',...
'% ---- classify: export (V2G) vs charge (G2V) -----------------------',...
'isExp=zeros(3,1); active=zeros(3,1); Pacc=zeros(3,1);',...
'for g=1:3',...
'  if connected(g)>0.5 && v2g(g)>0.5 && evSOC(g)>socMin',...
'    isExp(g)=1; active(g)=1; Pacc(g)=min([v2g(g),PgunMax,PmaxV(g)]);',...
'  elseif connected(g)>0.5 && evSOC(g)<soc_stop && evPmax(g)>1',...
'    active(g)=1; Pacc(g)=min(evPmax(g),PgunMax);',...
'  end',...
'end',...
'% ---- equal-finish-time SOFT sizing (G2V only) ---------------------',...
'Pdes=Pacc; Eneed=zeros(3,1);',...
'for g=1:3, if active(g)>0.5 && isExp(g)<0.5, Eneed(g)=Cap_kWh(g)*max(soc_stop-evSOC(g),0); end, end',...
'if sum(Eneed)>1e-3',...
'  Tstar=sum(Eneed)/max(Pstn,1e-3);',...
'  for g=1:3, if active(g)>0.5 && isExp(g)<0.5 && Pacc(g)>1, Tstar=max(Tstar,Eneed(g)/Pacc(g)); end, end',...
'  for g=1:3, if active(g)>0.5 && isExp(g)<0.5, Pdes(g)=min(Eneed(g)/max(Tstar,1e-4),Pacc(g)); end, end',...
'end',...
'% ---- priority score (fixed weights) -------------------------------',...
'Etot=max(sum(Edel),1e-6);',...
'for g=1:3',...
'  if active(g)>0.5',...
'    if isExp(g)>0.5',...
'      prio(g)=0.5 + 10*emergency(g);   % V2G mid priority for module claim',...
'    else',...
'      S=1-evSOC(g); D=min(Pdes(g)/PgunMax,1); trem=max(tdep(g)-t,60)/3600;',...
'      U=min(Cap_kWh(g)*(soc_stop-evSOC(g))/max(evPmax(g)*trem,1e-3),2); F=1-Edel(g)/Etot;',...
'      prio(g)=wS*S+wD*D+wU*U+wF*F+10*emergency(g);',...
'    end',...
'  end',...
'end',...
'prioF=prioF+(Ts/tauF)*(prio-prioF);',...
'for k=1:2, a=ordP(k); b=ordP(k+1); if prioF(b)>prioF(a)+DB, ordP(k)=b; ordP(k+1)=a; end, end',...
'% ---- events -------------------------------------------------------',...
'evPlug=any(abs(connected-lastC)>0.5); evDer=abs(Pstn-lastP)>5; evTap=0;',...
'for g=1:3',...
'  if modMap(g)>1 && active(g)>0.5 && Pdes(g)<(modMap(g)-1)*Pmod-MARGIN',...
'    taperC(g)=taperC(g)+Ts; if taperC(g)>TSUST, evTap=1; end',...
'  else, taperC(g)=0; end',...
'end',...
'dwellOK=(t-tLast)>TDWELL; forced=evPlug; wantRe=forced||(dwellOK&&(evDer||evTap));',...
'% ---- target module map (event-driven) -----------------------------',...
'if reSt==0 && wantRe',...
'  tgt=zeros(3,1); left=NmodTot;',...
'  for k=1:3, g=ordP(k); if active(g)>0.5 && tgt(g)==0 && left>0, tgt(g)=1; left=left-1; end, end',...
'  for k=1:3, g=ordP(k);',...
'    if active(g)>0.5, nWant=min(ceil(Pdes(g)/Pmod),NmodGunMax); add=min(nWant-tgt(g),left); if add>0, tgt(g)=tgt(g)+add; left=left-add; end, end',...
'  end',...
'  adopt=1;',...
'  if ~forced',...
'    oldDel=0; newDel=0;',...
'    for g=1:3, oldDel=oldDel+min(modMap(g)*Pmod,Pdes(g)); newDel=newDel+min(tgt(g)*Pmod,Pdes(g)); end',...
'    if (newDel-oldDel)<Pmod && evTap==0, adopt=0; end',...
'  end',...
'  if adopt && any(tgt~=modMap)',...
'    pendMap=tgt;',...
'    if all(tgt>=modMap), swCnt=swCnt+sum(abs(tgt-modMap)); modMap=tgt; tLast=t; taperC=zeros(3,1);',...
'    else reSt=1; reT=0; end',...
'  end',...
'end',...
'if reSt==1, reT=reT+Ts; if reT>=TRD, reSt=2; reT=0; end',...
'elseif reSt==2, reT=reT+Ts; if reT>=TSW, swCnt=swCnt+sum(abs(pendMap-modMap)); modMap=pendMap; tLast=t; taperC=zeros(3,1); reSt=0; reT=0; end',...
'end',...
'% ---- power within module ceilings + station limit -----------------',...
'ceilP=zeros(3,1);',...
'for g=1:3, n=modMap(g); if reSt>0 && pendMap(g)<modMap(g), n=pendMap(g); end, ceilP(g)=min(n*Pmod,PgunMax); end',...
'for g=1:3, Palloc(g)=min(ceilP(g),Pdes(g)); end',...
'drawSum=0; for g=1:3, if isExp(g)<0.5, drawSum=drawSum+Palloc(g); end, end',...
'if drawSum>Pstn && drawSum>0, sc=Pstn/drawSum; for g=1:3, if isExp(g)<0.5, Palloc(g)=Palloc(g)*sc; end, end, end',...
'left=Pstn-drawSum;',...
'for k=1:3, g=ordP(k); if left<=0, break; end, if isExp(g)<0.5, room=min(ceilP(g),Pacc(g))-Palloc(g); give=min(room,left); if give>0, Palloc(g)=Palloc(g)+give; left=left-give; end, end, end',...
'% ---- current targets (sign preserved) -----------------------------',...
'for g=1:3',...
'  if isExp(g)>0.5',...
'    Palloc(g)=-Palloc(g);',...
'    IrefT(g)=-min(abs(Palloc(g))*1000/max(vbat(g),100),ImaxV(g));',...
'  elseif Palloc(g)>0',...
'    IrefT(g)=min(Palloc(g)*1000/max(vbat(g),100),evImax(g));',...
'  end',...
'end',...
'% ---- bookkeeping --------------------------------------------------',...
'Edel=Edel+abs(Palloc)*(Ts/3600); lastC=connected; lastP=Pstn; Nmod=modMap;',...
'Ptot=0; for g=1:3, Ptot=Ptot+abs(Palloc(g)); end',...
'util=[Ptot; 100*Ptot/max(Pstn,1e-6); Pstn-Ptot]; st=[reSt; swCnt; max(TDWELL-(t-tLast),0)];',...
'% ---- module-ID assignment (fault-aware) ---------------------------',...
'for id=1:6, if ModStatus(id)>=2 && modOwner(id)~=0, modOwner(id)=0; end, end',...
'curCnt=zeros(3,1); for g=1:3, curCnt(g)=sum(modOwner==g); end',...
'for g=1:3, ex=curCnt(g)-modMap(g); if ex>0, for id=6:-1:1, if ex<=0, break; end, if modOwner(id)==g, modOwner(id)=0; ex=ex-1; end, end, end, end',...
'for g=1:3, curCnt(g)=sum(modOwner==g); end',...
'for k=1:3, g=ordP(k); need=modMap(g)-curCnt(g); if need>0, for id=1:6, if need<=0, break; end, if modOwner(id)==0 && ModStatus(id)==0, modOwner(id)=g; need=need-1; end, end, end, end',...
'ModAssign=modOwner;',...
'end');
end

% =====================================================================
