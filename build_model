function build_dc_fast_charger(ov)
%BUILD_DC_FAST_CHARGER  Extended builder for the Smart Multi-Gun DC Fast Charger.
%   Generates FINAL_DC_MULTIGUN_CHARGER_NEW.slx 
%   This is the proven G2V build
%   EXTENDED, additively, with:
%     * scenario-specific initial SOC / temperature / deadlines / connection
%       / grid-cap window / module fault  (via the optional OV struct)
%     * a contained V2G (bidirectional) path - negative power is preserved end
%       to end through Supervisor -> RefGen -> DCDC -> Battery -> AFE -> grid.
%       When OV.v2g is all-zero the model is numerically identical to the proven
%       G2V model (the negative path is simply never taken).
%     * spec thermal regions  NORMAL<40 | WARM 40-50 | HOT 50-55 | PROT>=55,
%       protection => evPmax=0 => Palloc=0 => that EV's modules are released.
%     * exactly SEVEN visible scopes; every other signal goes to To Workspace.
%
%   Usage:
%       build_dc_fast_charger                 % default = Scenario 2 baseline
%       build_dc_fast_charger(ov)             % ov from scenario_config (run_validation)
%       out = sim('FINAL_DC_MULTIGUN_CHARGER_NEW');
%
%   NOTE: written for MATLAB R2021b. It was authored without a MATLAB runtime
%   available to the author, so RUN IT ONCE and use run_validation.m to confirm
%   behaviour; the build self-checks every function block's port counts.

mdl = 'FINAL_DC_MULTIGUN_CHARGER_NEW';

% --- keep Simulink build/cache files under a SHORT path -----------------
% MATLAB Function blocks generate C into slprj\...; from a deep folder that
% path exceeds the Windows 260-char limit. Redirect it to a short folder so
% the build works regardless of where these .m files live.
bdir = 'C:\slbuild';
try
    if ~exist(bdir,'dir'), mkdir(bdir); end
catch
    bdir = fullfile(tempdir,'slb'); if ~exist(bdir,'dir'), mkdir(bdir); end
end
try
    Simulink.fileGenControl('set','CacheFolder',bdir,'CodeGenFolder',bdir,'createDir',true);
catch
end

P = init_params;

if nargin < 1, ov = struct(); end
% ---- scenario overrides: schema comes from scenario_config (single source
%      of truth shared with run_validation.m, so the two cannot drift) -----
d = scenario_config('defaults');
f = fieldnames(d);
for i=1:numel(f)
    if ~isfield(ov,f{i}) || isempty(ov.(f{i})), ov.(f{i}) = d.(f{i}); end
end
% reject anything the builder does not understand rather than silently ignoring it
extra = setdiff(fieldnames(ov), f);
if ~isempty(extra)
    error('build:unknownOverride', ...
        'Unknown override field(s): %s. Valid fields: %s', ...
        strjoin(extra,', '), strjoin(f,', '));
end

% apply SOC/temperature overrides into P (initial conditions)
P.soc0 = ov.soc0(:);
P.ev.Temp0 = ov.temp0(:).';
P.bms1 = sprintf('[%g;%g;%g;%g;%g;%g;%g]',P.ev.Cap_kWh(1),P.ev.Vnom(1),P.ev.Vmax(1),P.ev.Imax_A(1),P.ev.Pmax_kW(1),P.ev.Rint(1),ov.temp0(1));
P.bms2 = sprintf('[%g;%g;%g;%g;%g;%g;%g]',P.ev.Cap_kWh(2),P.ev.Vnom(2),P.ev.Vmax(2),P.ev.Imax_A(2),P.ev.Pmax_kW(2),P.ev.Rint(2),ov.temp0(2));
P.bms3 = sprintf('[%g;%g;%g;%g;%g;%g;%g]',P.ev.Cap_kWh(3),P.ev.Vnom(3),P.ev.Vmax(3),P.ev.Imax_A(3),P.ev.Pmax_kW(3),P.ev.Rint(3),ov.temp0(3));
P.mode = ov.mode; P.scenario = ov.scenario;
P.faultSchedule = ov.fault;

%% ------------------------------------------------------------- NEW MODEL
if bdIsLoaded(mdl), close_system(mdl,0); end
if exist([mdl '.slx'],'file'), delete([mdl '.slx']); end
new_system(mdl); load_system(mdl);
set_param(mdl,'Solver','FixedStepDiscrete','FixedStep',num2str(P.ts.fast), ...
              'StopTime',num2str(P.tstop),'SaveFormat','Dataset','ReturnWorkspaceOutputs','on');
assignin(get_param(mdl,'ModelWorkspace'),'P',P);

try
%% ---- BMS input panel ---------------------------------------------------
add_block('simulink/Sources/Constant',[mdl '/VEH1_BMS'],'Value',P.bms1,'Position',[40 560 150 590]);
add_block('simulink/Sources/Constant',[mdl '/VEH2_BMS'],'Value',P.bms2,'Position',[40 610 150 640]);
add_block('simulink/Sources/Constant',[mdl '/VEH3_BMS'],'Value',P.bms3,'Position',[40 660 150 690]);
add_block('simulink/Signal Routing/Mux',[mdl '/BMS_bus'],'Position',[190 560 200 690],'Inputs','3','DisplayOption','bar');
add_line(mdl,'VEH1_BMS/1','BMS_bus/1','autorouting','on');
add_line(mdl,'VEH2_BMS/1','BMS_bus/2','autorouting','on');
add_line(mdl,'VEH3_BMS/1','BMS_bus/3','autorouting','on');

%% ---- MATLAB Function blocks -------------------------------------------
addMF = @(name,pos) add_block('simulink/User-Defined Functions/MATLAB Function',[mdl '/' name],'Position',pos);

addMF('ScenarioGen',[40 120 190 340]);
src = scenario_src();
src = inject(src,'CONN0 = [1;1;1];',   sprintf('CONN0 = %s;',   mat2str(ov.conn0(:))));
src = inject(src,'TDEP = [3400;3000;3400];', sprintf('TDEP = %s;', mat2str(ov.tdep(:))));
src = inject(src,'V2GREQ = [0;0;0];',  sprintf('V2GREQ = %s;',  mat2str(ov.v2g(:))));
src = inject(src,'TAMB = 25;',         sprintf('TAMB = %.10g;', ov.tamb));
src = inject(src,'GC0 = 180;',         sprintf('GC0 = %.10g;',  ov.gc0));
src = inject(src,'GCLO = 180;',        sprintf('GCLO = %.10g;', ov.gclo));
src = inject(src,'GT0 = 1e9;',         sprintf('GT0 = %.10g;',  ov.gt0));
src = inject(src,'GT1 = 1e9;',         sprintf('GT1 = %.10g;',  ov.gt1));
src = inject(src,'DISCEV = 0;',        sprintf('DISCEV = %d;',  ov.discEV));
src = inject(src,'DISCT = 1e9;',       sprintf('DISCT = %.10g;',ov.discT));
src = inject(src,'LATEEV = 0;',        sprintf('LATEEV = %d;',  ov.lateEV));
src = inject(src,'LATET = 0;',         sprintf('LATET = %.10g;',ov.lateT));
set_mf_script(mdl,'ScenarioGen',src,P.ts.fast);

addMF('VehicleComms',[260 380 400 540]);
src = comms_src(); src = inject(src,'SOC0_VEC = [0.15;0.30;0.55];',sprintf('SOC0_VEC = %s;',mat2str(ov.soc0(:))));
set_mf_script(mdl,'VehicleComms',src,P.ts.fast);

addMF('Constraints',[260 60 400 150]);
