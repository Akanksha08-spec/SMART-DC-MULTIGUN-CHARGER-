'Tb=Tb+Ts*(Ploss-(Tb-Tamb)/max(RTH_INJECT,1e-6))/max(CTH_INJECT,1e-6);',...
'if Tb<-30, Tb=-30; end; if Tb>90, Tb=90; end',...
'soc=SOC; vbat=V; tbat=Tb;',...
'end');
end

% =====================================================================
% Module_Pool - switchable 6x30 kW pool; Pin/Ploss physical for both dirs
% =====================================================================
function s = modpool_src()
s = sprintf('%s\n',...
'function [Pin,Ploss,ModAssign,ModStatus,AvailCnt,ActiveCnt,ModUtil,SwEvents,PavailG] = ModulePool(Pdc1,Pdc2,Pdc3,TargetOwner,t)',...
'%#codegen',...
'Pmod=30; eta=0.955; SWLOSS_KW=0.3;',...
'TRD_M=1.0; TOPEN_M=0.2; TDEAD_M=0.5; TCONN_M=0.2; TRUP_M=1.0;',...
'FAULT_SCHEDULE=zeros(0,4); Ts=0.1;',...
'persistent owner phase timer contrib pend swCnt initMP;',...
'if isempty(initMP), owner=zeros(6,1); phase=zeros(6,1); timer=zeros(6,1); contrib=zeros(6,1); pend=zeros(6,1); swCnt=0; initMP=1; end',...
'health=zeros(6,1);',...
'for r=1:size(FAULT_SCHEDULE,1), mid=FAULT_SCHEDULE(r,1); if t>=FAULT_SCHEDULE(r,2) && t<=FAULT_SCHEDULE(r,3), health(mid)=FAULT_SCHEDULE(r,4); end, end',...
'for id=1:6',...
'  tgt=TargetOwner(id);',...
'  if health(id)~=0',...
'    owner(id)=0; pend(id)=0; contrib(id)=0;',...
'    if phase(id)~=0, timer(id)=timer(id)+Ts; if timer(id)>=TDEAD_M, phase(id)=0; timer(id)=0; end, end',...
'  else',...
'    switch phase(id)',...
'      case 0, if tgt>0, pend(id)=tgt; phase(id)=5; timer(id)=0; end',...
'      case 1, if tgt~=owner(id), pend(id)=tgt; phase(id)=2; timer(id)=0; end',...
'      case 2, timer(id)=timer(id)+Ts; contrib(id)=max(1-timer(id)/max(TRD_M,1e-3),0); if timer(id)>=TRD_M, phase(id)=3; timer(id)=0; contrib(id)=0; end',...
'      case 3, timer(id)=timer(id)+Ts; if timer(id)>=TOPEN_M, owner(id)=0; phase(id)=4; timer(id)=0; end',...
'      case 4, timer(id)=timer(id)+Ts; if timer(id)>=TDEAD_M, if pend(id)>0, phase(id)=5; timer(id)=0; else phase(id)=0; timer(id)=0; end, end',...
'      case 5, timer(id)=timer(id)+Ts; if timer(id)>=TCONN_M, owner(id)=pend(id); pend(id)=0; phase(id)=6; timer(id)=0; end',...
'      case 6, timer(id)=timer(id)+Ts; contrib(id)=min(timer(id)/max(TRUP_M,1e-3),1); if timer(id)>=TRUP_M, phase(id)=1; timer(id)=0; contrib(id)=1; swCnt=swCnt+1; end',...
'    end',...
'  end',...
'end',...
'ModAssign=owner; ModUtil=contrib; ModStatus=zeros(6,1);',...
'for id=1:6, if health(id)~=0, ModStatus(id)=health(id)+1; elseif phase(id)==0, ModStatus(id)=0; else ModStatus(id)=1; end, end',...
'AvailCnt=sum(ModStatus==0); ActiveCnt=sum(phase>0 & health==0); SwEvents=swCnt;',...
'PavailG=zeros(3,1); for id=1:6, gg=owner(id); if gg>0, PavailG(gg)=PavailG(gg)+contrib(id)*Pmod; end, end',...
'nTrans=sum(phase>=2 & phase<=5 & health==0);',...
'Pdc=Pdc1+Pdc2+Pdc3;',...
'if Pdc>=0, Pin=Pdc/eta+SWLOSS_KW*nTrans; else Pin=Pdc*eta+SWLOSS_KW*nTrans; end',...
'Ploss=abs(Pin-Pdc);',...
'end');
end

