'function [soc,vbat,tbat] = Battery(ibat,bms,Tamb)',...
'%#codegen',...
'G_INJECT=1; g=G_INJECT; o=(g-1)*7;',...
'SOC0_INJECT=0.15; TBAT0_INJECT=30; CTH_INJECT=6e4; RTH_INJECT=0.01;',...
'Cap_kWh=bms(o+1); Vnom=bms(o+2); Vmax=bms(o+3); Rint=bms(o+6);',...
'% initial SOC and initial pack temperature are scenario INITIAL CONDITIONS',...
'% injected at build time (ov.soc0 / ov.temp0) - deliberately NOT taken from',...
'% the runtime BMS panel, so editing VEH*_BMS cannot move the start state.',...
'Ts=0.1; persistent SOC Tb; if isempty(SOC), SOC=SOC0_INJECT; Tb=TBAT0_INJECT; end',...
'Ah=Cap_kWh*1000/max(Vnom,100);',...
'SOC=min(max(SOC+ibat*Ts/3600/Ah,0),1);   % charge + discharge (V2G)',...
'ocv=Vnom*(0.86+0.10*SOC+0.10*max(SOC-0.8,0)/0.2);',...
'V=ocv+ibat*Rint; if V>Vmax, V=Vmax; end; if V<0.5*Vnom, V=0.5*Vnom; end',...
