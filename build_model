% =====================================================================
% helpers (identical mechanism to the proven builder)
% =====================================================================
function set_mf_script(mdl,blk,src,Ts)
blkPath=[mdl '/' blk];
if ~getSimulinkBlockHandle(blkPath), error('build:noBlock','%s missing',blkPath); end
ch=[];
for k=1:60, rt=sfroot; ch=rt.find('-isa','Stateflow.EMChart','Path',blkPath); if ~isempty(ch), break; end, pause(0.05); end
if isempty(ch), error('build:noChart','Chart for %s not found; run: bdclose all; clear functions; retry.',blk); end
ch=ch(1); ch.Script=src;
if isempty(strfind(ch.Script,'function')) %#ok<STREMP>
    error('build:scriptNotSet','Script not applied to %s.',blk);
end
try ch.ChartUpdateMethod='DISCRETE'; ch.SampleTime=num2str(Ts);
catch, try set_param(blkPath,'SampleTime',num2str(Ts)); catch, end, end
end

function s = inject(s,target,replacement)
%INJECT  strrep that FAILS LOUDLY if the target is absent.
%   A plain strrep whose target does not match silently does nothing, which
%   produces a model that builds and runs but quietly ignores the scenario
%   override. Every build-time injection goes through here so that a
%   mismatch is a build error, never a silent no-op.
if ~contains(s,target)
    error('build:injectTarget', ...
        ['Injection target "%s" not found in the generated source. The ' ...
         'override would have been silently ignored.'], target);
end
s = strrep(s,target,replacement);
end

function verify_ports(mdl,blk,nIn,nOut)
p=[];
for k=1:60, try p=get_param([mdl '/' blk],'Ports'); catch, p=[]; end
    if numel(p)>=2 && p(1)==nIn && p(2)==nOut, return; end, pause(0.05); end
if numel(p)<2, p=[0 0]; end
error('build:ports','%s shows %d/%d ports, expected %d/%d (script did not compile).',blk,p(1),p(2),nIn,nOut);
end

% =====================================================================
% SCENARIO GENERATOR - driven by injected vectors (run_validation sets them)
% =====================================================================
function s = scenario_src()
s = sprintf('%s\n',...
'function [connected,emergency,tdep,gridCap,Tamb,v2g] = ScenarioGen(t)',...
'%#codegen',...
'CONN0 = [1;1;1];',...
'TDEP = [3400;3000;3400];',...
'V2GREQ = [0;0;0];',...
'TAMB = 25;',...
'GC0 = 180; GCLO = 180; GT0 = 1e9; GT1 = 1e9;',...
'DISCEV = 0; DISCT = 1e9;',...
'LATEEV = 0; LATET = 0;',...
'connected = CONN0;',...
'if LATEEV>=1 && LATEEV<=3 && t < LATET, connected(LATEEV) = 0; end',...
'if DISCEV>=1 && DISCEV<=3 && t >= DISCT, connected(DISCEV) = 0; end',...
'gridCap = GC0; if t >= GT0 && t < GT1, gridCap = GCLO; end',...
'Tamb = TAMB;',...
'tdep = TDEP;',...
'v2g = V2GREQ .* (connected > 0.5);',...
'emergency = zeros(3,1);',...
'end');
end

% =====================================================================
% VEHICLE COMMS - live-temperature derating (spec regions) + Pmax_temp out
% =====================================================================
function s = comms_src()
s = sprintf('%s\n',...
'function [evSOC,evImax,evPmax,evTemp,evThermStat,evPmaxTemp] = VehicleComms(soc,vbat,ibat,connected,bms,tbatMeas) %#ok<INUSD>',...
'%#codegen',...
'SOC0_VEC = [0.15;0.30;0.55];',...
'ImaxRaw = [bms(4); bms(11); bms(18)];',...
'PmaxRaw = [bms(5); bms(12); bms(19)];',...
